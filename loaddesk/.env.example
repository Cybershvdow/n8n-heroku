# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loaddesk?schema=public"

# Redis (for BullMQ jobs)
REDIS_URL="redis://localhost:6379"

# Session encryption key (generate with: openssl rand -hex 32)
SESSION_SECRET="your-32-byte-hex-secret-here"

# Token encryption key for OAuth tokens (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="your-32-byte-hex-secret-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft 365 OAuth (Azure Portal)
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""

# AI Provider (choose one)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER="openai"  # or "anthropic"

# Rate limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
AUTH_RATE_LIMIT_MAX="5"

# Environment
NODE_ENV="development"
