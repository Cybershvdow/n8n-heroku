# =========================
# DATABASE
# =========================
DATABASE_URL="postgresql://user:password@localhost:5432/wp_ai?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/wp_ai?schema=public"

# =========================
# SUPABASE
# Get from: https://supabase.com/dashboard
# =========================
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# IMPORTANT: Create these Supabase Storage buckets:
# - walkthrough-photos (public)
# - voice-notes (public)
# - proposal-pdfs (public)
# - proposal-signatures (public)

# =========================
# AI APIS (Phase 2 Features)
# =========================
# Anthropic Claude - For AI pricing suggestions
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI - For voice transcription (Whisper)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# =========================
# EMAIL (Phase 2 Features)
# =========================
# Resend - For sending proposal emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# =========================
# APP CONFIGURATION
# =========================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# For production, set to your domain:
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
