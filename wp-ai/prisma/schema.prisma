// W&P AI Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  company       String?
  phone         String?
  createdAt     DateTime  @default(now())

  hourlyWage    Float     @default(20.00)
  targetMargin  Float     @default(0.30)

  clients       Client[]
  walkthroughs  Walkthrough[]
  proposals     Proposal[]
  pricingRules  PricingRule[]
  proposalTemplates     ProposalTemplate[]
  walkthroughTemplates  WalkthroughTemplate[]
  contentTemplates      ContentTemplate[]
  aiTrainingGuidelines  AITrainingGuideline[]
  aiTrainingExamples    AITrainingExample[]
  aiTrainingDocuments   AITrainingDocument[]
}

model Client {
  id            String    @id @default(uuid())
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  walkthroughs  Walkthrough[]
  proposals     Proposal[]
}

model Walkthrough {
  id                String    @id @default(uuid())
  clientId          String
  propertyAddress   String
  totalSqft         Float?
  facilityType      String?
  serviceFrequency  String    @default("daily")
  daysPerWeek       Int       @default(5)
  status            String    @default("draft")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId            String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  rooms             Room[]
  photos            Photo[]
  voiceNotes        VoiceNote[]
  notes             Note[]
  proposal          Proposal?
}

model Room {
  id                String    @id @default(uuid())
  walkthroughId     String
  name              String
  roomType          String
  squareFeet        Float?
  floorType         String?
  estimatedMinutes  Int
  specialNotes      String?
  createdAt         DateTime  @default(now())

  walkthrough       Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  photos            Photo[]
}

model Photo {
  id                String    @id @default(uuid())
  walkthroughId     String
  roomId            String?
  url               String
  caption           String?
  createdAt         DateTime  @default(now())

  walkthrough       Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  room              Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model VoiceNote {
  id                String    @id @default(uuid())
  walkthroughId     String
  audioUrl          String
  transcription     String?
  duration          Int?
  createdAt         DateTime  @default(now())

  walkthrough       Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
}

model Note {
  id                String    @id @default(uuid())
  walkthroughId     String
  content           String
  createdAt         DateTime  @default(now())

  walkthrough       Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
}

model Proposal {
  id                String    @id @default(uuid())
  walkthroughId     String    @unique
  clientId          String
  title             String

  totalMonthlyHours Float
  laborCost         Float
  customerRate      Float
  monthlyPrice      Float
  profitMargin      Float

  introduction      String?   @db.Text
  scopeOfWork       String?   @db.Text
  termsConditions   String?   @db.Text

  status            String    @default("draft")
  category          String?
  tags              String[]

  sentAt            DateTime?
  viewedAt          DateTime?
  viewCount         Int       @default(0)
  downloadCount     Int       @default(0)
  signedAt          DateTime?
  signatureUrl      String?
  signerName        String?
  signerEmail       String?

  publicUrl         String?   @unique
  pdfUrl            String?

  templateId        String?
  templateName      String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId            String
  walkthrough       Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  activities        ProposalActivity[]
  aiSuggestion      AISuggestion?
}

model ProposalActivity {
  id                String    @id @default(uuid())
  proposalId        String
  activityType      String
  metadata          Json?
  createdAt         DateTime  @default(now())

  proposal          Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model PricingRule {
  id                String    @id @default(uuid())
  userId            String
  roomType          String
  estimatedMinutes  Int
  description       String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AISuggestion {
  id                String    @id @default(uuid())
  proposalId        String    @unique
  suggestedRate     Float
  confidence        Float
  reasoning         String    @db.Text
  similarProjects   Json?
  userAccepted      Boolean?
  userFeedback      String?
  createdAt         DateTime  @default(now())

  proposal          Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

// ========== TEMPLATES SYSTEM ==========

model ProposalTemplate {
  id                String    @id @default(uuid())
  userId            String
  name              String
  description       String?
  category          String?

  // Visual styling
  layout            String    @default("standard")
  colorScheme       String    @default("dark")
  headerStyle       String    @default("default")

  // Default content
  introduction      String?   @db.Text
  scopeOfWork       String?   @db.Text
  termsConditions   String?   @db.Text

  // Settings
  isPublic          Boolean   @default(false)
  isDefault         Boolean   @default(false)
  useCount          Int       @default(0)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalkthroughTemplate {
  id                String    @id @default(uuid())
  userId            String
  name              String
  description       String?
  facilityType      String

  // Default settings
  serviceFrequency  String    @default("daily")
  daysPerWeek       Int       @default(5)
  totalSqft         Float?

  // Template configuration
  isPublic          Boolean   @default(false)
  isDefault         Boolean   @default(false)
  useCount          Int       @default(0)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms             TemplateRoom[]
}

model TemplateRoom {
  id                String    @id @default(uuid())
  templateId        String
  name              String
  roomType          String
  estimatedMinutes  Int
  floorType         String?
  squareFeet        Float?
  specialNotes      String?
  sortOrder         Int       @default(0)

  createdAt         DateTime  @default(now())

  template          WalkthroughTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ContentTemplate {
  id                String    @id @default(uuid())
  userId            String
  name              String
  category          String
  content           String    @db.Text

  // Metadata
  isPublic          Boolean   @default(false)
  useCount          Int       @default(0)
  tags              String[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========== AI TRAINING SYSTEM ==========

model AITrainingGuideline {
  id                String    @id @default(uuid())
  userId            String
  title             String
  content           String    @db.Text
  category          String    @default("general")
  priority          Int       @default(5)
  isActive          Boolean   @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AITrainingExample {
  id                String    @id @default(uuid())
  userId            String
  title             String
  description       String?

  // Example details
  facilityType      String
  squareFeet        Float?
  totalRooms        Int
  serviceFrequency  String
  daysPerWeek       Int

  // Pricing
  employeeWage      Float
  customerRate      Float
  monthlyPrice      Float
  profitMargin      Float

  // Outcome
  outcome           String    @default("unknown")
  notes             String?   @db.Text

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AITrainingDocument {
  id                String    @id @default(uuid())
  userId            String
  name              String
  description       String?
  category          String    @default("reference")

  // File info
  fileUrl           String
  fileType          String
  fileSize          Int

  // Extracted content (for AI to reference)
  extractedText     String?   @db.Text
  summary           String?   @db.Text

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
